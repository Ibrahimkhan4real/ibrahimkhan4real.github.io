---
layout: null
permalink: /rag-feed.json
---
{
  "generated_at": {{ site.time | date_to_xmlschema | jsonify }},
  "live": {
    "updated": {{ site.data.now.updated | jsonify }},
    "content": {{ site.data.now.content | jsonify }},
    "projects": {{ site.data.now.projects | jsonify }}
  },
  "posts": [
    {% for post in site.posts %}
    {
      "title": {{ post.title | jsonify }},
      "date": {{ post.date | date_to_xmlschema | jsonify }},
      "url": {{ post.url | absolute_url | jsonify }},
      "excerpt": {{ post.excerpt | strip_html | jsonify }},
      "content": {{ post.content | strip_html | jsonify }}
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}
